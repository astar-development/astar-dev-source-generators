<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>netstandard2.0;net10.0</TargetFrameworks>
    <AssemblyName>AStar.Dev.Source.Generators.Abstractions</AssemblyName>
    <PackageId>AStar.Dev.Source.Generators.Abstractions</PackageId>
    <Description>
      Attributes and marker types consumed by AStar.Dev.Source.Generators.
      Reference this package in any project that uses the source generators.
    </Description>

    <!--
      This project is intentionally tiny: attributes only.
      Disable implicit usings so the output stays minimal.
    -->
    <ImplicitUsings>disable</ImplicitUsings>
  </PropertyGroup>

</Project>
